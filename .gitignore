# Bronze nflverse downloads are re-fetchable from immutable release URLs; keep out of git.
data/raw/
data/silver/
data/gold/
data/cache/
data/shadow/
# Kalshi observations live on the orphan branch `market-data`, never on main.
data/kalshi/
data/context/
*.pyc
__pycache__/
.pytest_cache/
*.egg-info/
.venv/
research/scratch/
research/opportunity/opportunity_features.parquet
# Handicap packets are build artifacts: packet.json runs to ~12MB per slate and is regenerated by
# `scripts/handicap/run_nfl.py` from the immutable ledger. A trimmed dry-run sample is committed under
# research/handicap_dryrun/ instead.
data/handicap/
# The workflow's report directory is the same build artifact under a different name; packet.json is ~15MB
# and belongs on the `handicap-reports` branch and in the run's artifact, never on main.
data/handicap_report/
# Simulation-layer walk-forward outputs are regenerable (scripts/sim/walkforward.py) and tens of MB per
# season; the fitted bundles, the weights and the summary JSON/markdown are committed, the row-level
# parquets are not.
research/simulation_engine/*_dists_*.parquet
research/simulation_engine/reconciliation_scored_*.parquet
research/simulation_engine/week1_2026_diagnostic_rows.parquet
